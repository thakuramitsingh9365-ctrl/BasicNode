<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Form</title>
</head>
<body>
    
    <h2>Book Registration</h2>

    <form action="/insert" method="get">
        <label for="bookname">Book Name:</label>
        <input type="text" name="bookname" id="bookname" placeholder="Enter book name"><br><br>
        <label for="author">Author:</label>
        <input type="text" name="author" id="author" placeholder="Enter author name"><br><br>
        <label for="genre">Genre:</label>
        <input type="text" name="genre" id="genre" placeholder="Enter genre"><br><br>

        <button type="submit">Submit</button><br><br>
        <button type="button" onclick="f()">Clear</button>
    </form>
    
    <script>
        function f(){
            document.querySelector("#bookname").value="";
            document.querySelector("#author").value="";
            document.querySelector("#genre").value="";
        } 
    </script>
</body>
</html>