<!DOCTYPE html>
<html>
<head>
  <title>Product List</title>
  <style>
     .brand{
        color: blue;
     }
     .product-image{
        height: 200px;
        width: 200px;
        margin-left: 300px;
     }
  </style>
</head>
<body>
  <h1 style="color: red;">Product List</h1>
  <ul class="brand">
    <% products.forEach((product) => { %>
        <li>
            <img class="product-image" src="<%= product.image%>" alt="<%= product.name%>">
            <%= product.name%>-
           <%= product.price%>-
            <%= product.brand%>-

        </li>
      <li><%= product.name %> - <%= product.price %> - <%= product.brand %></li>
    <% }) %>
  </ul>
</body>
</html>