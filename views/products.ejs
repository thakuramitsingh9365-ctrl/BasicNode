<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
</head>
<body>
  
  <h1>Product List</h1>

  <ul>
    <% products.forEach((product)=>{ %>

      <li>
        <Strong>Name:</Strong><%= product.name %>
        <br>
        <strong>Price:</strong><%= product.price %>
      </li>
      <br>
    <%});%>
  </ul>
</body>
</html>